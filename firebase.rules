// ============================================================
// Firebase Security Rules — AI Compass
// Project: AI Compass (Firebase Firestore)
//
// HOW TO DEPLOY:
//   1. Install firebase-tools:  npm install -g firebase-tools
//   2. Authenticate:           firebase login
//   3. Select project:         firebase use your-project-id
//   4. Deploy rules:           firebase deploy --only firestore:rules
//
// STORAGE RULES: see firebase.storage.rules
// DEPLOY INDEXES:   firebase deploy --only firestore:indexes
//
// INITIAL ADMIN SETUP (run once via Firebase Console or Admin SDK):
//   db.collection('admin_users').doc(YOUR_UID).set({ role: 'admin' })
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin role is stored in /admin_users/{uid} with { role: 'admin' }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidOptionalString(val, maxLen) {
      return val == null || isValidString(val, maxLen);
    }

    function isValidUrl(val) {
      return val is string && (val == '' || val.matches('https?://.*'));
    }

    function isValidEmail(val) {
      return val is string && val.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }

    function optionalEmailMatchesToken(fieldName) {
      // If fieldName is written at all and the caller is signed in,
      // the value must match the caller's token email (or both be null).
      return !(fieldName in request.resource.data)
        || (request.resource.data[fieldName] == null && request.auth.token.email == null)
        || (isSignedIn() && request.resource.data[fieldName] == request.auth.token.email);
    }

    function optionalUserIdMatchesToken(fieldName) {
      // If fieldName is written and the caller is signed in, the value must be
      // their own uid (or null / not provided). Prevents spoofing writes as other users.
      return !(fieldName in request.resource.data)
        || request.resource.data[fieldName] == null
        || (isSignedIn() && request.resource.data[fieldName] == request.auth.uid);
    }

    function assertNoFieldChange(fields, oldData, newData) {
      return fields.all(field, oldData[field] == newData[field]);
    }

    function requestTime() {
      return request.time;
    }

    // ── Admin users registry ────────────────────────────────────
    // Only readable/writable by existing admins.
    // Initial admin MUST be set via Firebase console or Admin SDK.
    match /admin_users/{uid} {
      allow read:   if isAdmin();
      allow write:  if isAdmin()
                    && request.resource.data.keys().hasOnly(['role', 'grantedAt', 'grantedBy', 'name', 'email'])
                    && request.resource.data.role is string
                    && request.resource.data.role in ['admin', 'moderator', 'editor'];
    }

    // ── Public catalog tools ───────────────────────────────────
    // Anyone can read published tools.
    // Only admins can create, update, or delete.
    match /tools/{toolId} {
      allow read: if (resource.data.status == 'published' || isAdmin());

      allow create: if isAdmin()
                    && isValidString(request.resource.data.name, 200)
                    && isValidUrl(request.resource.data.official_url)
                    && request.resource.data.keys().hasAll(['slug', 'name', 'status', 'created_at', 'updated_at'])
                    && request.resource.data.status in ['draft', 'published', 'archived'];

      allow update: if isAdmin()
                    && (!('name' in request.resource.data) || isValidString(request.resource.data.name, 200))
                    && (!('official_url' in request.resource.data) || isValidUrl(request.resource.data.official_url))
                    && (!('status' in request.resource.data) || request.resource.data.status in ['draft', 'published', 'archived']);

      allow delete: if isAdmin(); // prefer archive (status=archived) over hard delete
    }

    // ── Categories ──────────────────────────────────────────────
    // Public read. Admin write.
    match /categories/{catId} {
      allow read:   if true;
      allow write:  if isAdmin()
                    && isValidString(request.resource.data.name, 100)
                    && isValidString(request.resource.data.description, 500);
    }

    // ── Tags ────────────────────────────────────────────────────
    // Public read. Admin write.
    match /tags/{tagId} {
      allow read:   if true;
      allow write:  if isAdmin()
                    && isValidString(request.resource.data.name, 50);
    }

    // ── User profiles ───────────────────────────────────────────
    // Each user can read/write their own profile only.
    // Admins can read all for moderation / analytics.
    // BAN ENFORCEMENT: users cannot modify ban/role fields themselves.
    // Only admins can set disabled, ban_reason, banned_at, etc.
    //
    // NOTE: match /users/{uid} grants PER-DOCUMENT access for a known uid.
    // Admin dashboards also query the ENTIRE COLLECTION (getAnalytics,
    // adminListUsers), so admins need collection-level list access too.
    match /users/{uid} {
      // Per-document rules (also apply when you read via doc ref with known uid)
      allow read:   if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(
                        ['uid','email','displayName','display_name','photoURL','avatar_url','bio','preferences','createdAt','updatedAt','lastLoginAt','last_seen_at','first_seen_at','sign_in_count','created_at','updated_at']
                      )
                    && (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 100))
                    && (!('display_name' in request.resource.data) || isValidString(request.resource.data.display_name, 100))
                    && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);

      allow update: if (isOwner(uid) && !isAdmin())
                    // Owner updates — cannot touch ban/admin fields AT ALL (even to set them false/null)
                    && !('disabled' in request.resource.data)
                    && !('ban_reason' in request.resource.data)
                    && !('banned_at' in request.resource.data)
                    && !('banned_by' in request.resource.data)
                    && !('banned_by_uid' in request.resource.data)
                    && !('unbanned_at' in request.resource.data)
                    && !('unbanned_by' in request.resource.data)
                    && !('unbanned_by_uid' in request.resource.data)
                    // uid may be omitted in merge-style writes; if present it must match
                    && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
                    && (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 100))
                    && (!('display_name' in request.resource.data) || isValidString(request.resource.data.display_name, 100))
                    && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
                    && (!('bio' in request.resource.data) || isValidString(request.resource.data.bio, 500));

      allow update: if isAdmin()
                    // Admin updates — may change ban fields; cannot change uid
                    && (!('uid' in request.resource.data) || request.resource.data.uid == uid);

      allow delete: if isOwner(uid) || isAdmin();

      // Bookmarks subcollection — each user owns their own bookmarks
      match /bookmarks/{toolIdRef} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasOnly(['toolId','createdAt'])
                      && request.resource.data.toolId == toolIdRef;
        allow delete: if isOwner(uid);
        allow update: if false; // bookmarks are create/delete only
      }
    }

    // ── Collection-level admin list permissions ─────────────────
    // Firestore rules don't fall through: a collection query (e.g.
    //   getDocs(collection(db, "users"))
    // requires an `allow list` or `allow read` at that collection's level.
    // The per-document match above covers doc-by-doc reads; these explicit
    // collection-level rules cover ADMIN-ONLY collection listings used by
    // adminListUsers(), adminListSubmissions(), getAnalytics(), etc.
    match /users/{document=**} {
      allow read, write: if isAdmin();
    }
    match /admin_users/{document=**} {
      allow read:   if isAdmin();
      allow write:  if isAdmin()
                    && request.resource.data.keys().hasOnly(['role', 'grantedAt', 'grantedBy', 'name', 'email'])
                    && request.resource.data.role is string
                    && request.resource.data.role in ['admin', 'moderator', 'editor'];
    }

    // ── Tool submissions ────────────────────────────────────────
    // ONLY ADMINS can create tool submissions or manage imported records.
    // Regular users cannot submit AI tools directly — they must use the
    // Feedback channel ("Suggest an AI Tool" type) which stores to /feedback.
    // Admins can read all and update status/review_note.
    match /tool_submissions/{subId} {
      allow read:   if isAdmin();

      allow create: if isAdmin()
                    && request.resource.data.status in ['pending', 'approved', 'rejected']
                    // submitTool() writes: user_id, status, review_note, created_at, data{...}
                    && request.resource.data.keys().hasAll(['user_id', 'status', 'review_note', 'created_at', 'data'])
                    // 'data' must be a map/object of submitted tool fields (not free-form scalar)
                    && request.resource.data.data is map
                    && request.resource.data.data.keys().hasAll(['name', 'official_url', 'company', 'short_description', 'categories', 'submitter_notes', 'submitted_at']);

      allow update: if isAdmin()
                    // Admin can only change status + review_note, never user_id or submitted data
                    && assertNoFieldChange(['user_id', 'created_at', 'data'], resource.data, request.resource.data);

      allow delete: if isAdmin();
    }

    // ── Site settings ───────────────────────────────────────────
    // Public read (for tagline, announcement banner).
    // Admin write only.
    match /site_settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin()
                   && request.resource.data.keys().hasOnly(
                        ['announcement', 'tagline', 'submissions_open', 'updated_at', 'updated_by']
                      )
                   && isValidString(request.resource.data.announcement, 500)
                   && isValidString(request.resource.data.tagline, 200);
    }

    // ── Feedback / Suggestions (user submitted ideas, bugs, tool suggestions) ─────
    // Anyone (including anonymous) can create feedback.
    // Only admins can read, update, or delete feedback for moderation.
    // If the creator is signed in and includes user_id/user_email, they must
    // match their auth token to prevent impersonation.
    match /feedback/{fbId} {
      allow create: if request.resource.data.keys().hasAll(['type', 'message', 'page_url', 'created_at'])
                    && request.resource.data.type in ['bug', 'suggestion', 'incorrect_info', 'other', 'suggest_tool']
                    && isValidString(request.resource.data.message, 5000)
                    && isValidString(request.resource.data.page_url, 500)
                    // Anti-spoofing: identity fields must actually belong to the caller
                    && optionalUserIdMatchesToken('user_id')
                    && optionalEmailMatchesToken('user_email')
                    // Feedback initially created with status 'new' only; admins change it later
                    && (!('status' in request.resource.data) || request.resource.data.status == 'new')
                    && (!('reviewed_at' in request.resource.data) || request.resource.data.reviewed_at == null)
                    && (!('reviewed_by' in request.resource.data) || request.resource.data.reviewed_by == null)
                    && (!('admin_response' in request.resource.data) || request.resource.data.admin_response == null)
                    && (!('user_email' in request.resource.data) || isValidEmail(request.resource.data.user_email));

      allow read, update, delete: if isAdmin();
    }

    // ── Analytics / Events (public write, admin read) ───────────
    match /analytics/{eventId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // ── Page Views (fire-and-forget anonymous writes, admin-only reads) ─
    // Used by trackPageView() in admin-db.ts. Anyone (including unauthenticated)
    // may CREATE page views. Only admins may read/list page views.
    // No updates or deletes allowed (append-only audit log).
    // Anti-spoofing: signed-in writers can only record THEIR OWN user_id/email.
    match /page_views/{pvId} {
      allow create: if request.resource.data.keys().hasAll(
                         ['path','session_id','path_group','hour_bucket','day_bucket','week_bucket','month_bucket','created_at']
                       )
                    && isValidString(request.resource.data.path, 500)
                    && isValidString(request.resource.data.session_id, 200)
                    && isValidString(request.resource.data.path_group, 50)
                    && isValidString(request.resource.data.hour_bucket, 20)
                    && isValidString(request.resource.data.day_bucket, 20)
                    && isValidString(request.resource.data.week_bucket, 20)
                    && isValidString(request.resource.data.month_bucket, 20)
                    // Optional string length checks for analytics extras
                    && isValidOptionalString(request.resource.data.title, 300)
                    && isValidOptionalString(request.resource.data.referrer, 500)
                    && isValidOptionalString(request.resource.data.user_agent, 500)
                    && isValidOptionalString(request.resource.data.country_code, 3)
                    && isValidOptionalString(request.resource.data.country_name, 60)
                    // Anti-spoofing: identity fields must actually belong to caller
                    && optionalUserIdMatchesToken('user_id')
                    && optionalEmailMatchesToken('user_email');
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Deny everything else ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
