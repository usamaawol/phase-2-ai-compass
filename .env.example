# ============================================================
# AI Compass — Environment Variables Template (Firebase Only)
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ============================================================
#
# STEPS TO CONFIGURE FIREBASE:
#   1. Go to https://console.firebase.google.com
#   2. Create a project (or use an existing one)
#   3. Enable "Authentication" → Sign-in method → Google
#   4. Enable "Firestore Database" (create in production mode)
#   5. Enable "Storage" if you need user uploads
#   6. Go to Project settings → General → Your apps → Add app → Web app
#   7. Copy the config values below
#
# DEPLOY SECURITY RULES (after setting values):
#   npm install -g firebase-tools
#   firebase login
#   firebase use YOUR_PROJECT_ID
#   firebase deploy --only firestore:rules
#   firebase deploy --only storage:rules
#   firebase deploy --only firestore:indexes
#
# MAKE THE FIRST USER AN ADMIN:
#   a) Sign in via the web app first to create your account
#   b) Go to Firebase Console → Firestore Database
#   c) Create collection: admin_users
#   d) Add document: Document ID = your UID (find in Authentication → Users)
#   e) Add field: role = "admin" (string)
# ============================================================

# ── Firebase Web App Config ─────────────────────────────────
# Get from: Firebase Console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Optional: Google Analytics (leave blank to disable)
VITE_FIREBASE_MEASUREMENT_ID=""
